[debug] [2026-07-29T14:22:58.127Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/rosetta-d35a0/rulesets {"name":"projects/rosetta-d35a0/rulesets/01ddcb68-28ee-4a21-9ec6-3491780f91eb","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n    function isAdmin() {\n      return signedIn() && request.auth.token.email == \"chakrabartiaditya10@gmail.com\";\n    }\n    match /users/{userId} {\n      allow create, read, update: if signedIn() && request.auth.uid == userId;\n      allow read: if isAdmin();\n      allow delete: if false;\n    }\n    match /usage_events/{eventId} {\n      allow create: if signedIn()\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.keys().hasOnly([\n          \"uid\", \"feature\", \"method\", \"status\", \"duration_ms\", \"anonymous\", \"created_at\"\n        ]);\n      allow read: if isAdmin();\n      allow update, delete: if false;\n    }\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-29T14:22:58.110031Z","metadata":{"services":["cloud.firestore"]},"attachmentPoint":"firestore.googleapis.com/projects/625630291003/databases/default"}
