[debug] [2026-07-29T20:27:04.697Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/rosetta-d35a0/rulesets {"name":"projects/rosetta-d35a0/rulesets/1d1195b5-a8b4-4c52-be45-19e86ff0f32e","source":{"files":[{"content":"rules_version = '2';\n\n// Firestore security rules for Rosetta.\n//\n// Deploy with:  firebase deploy --only firestore:rules\n// Writing this file changes nothing until that runs -- whatever the project\n// was created with stays live otherwise.\n//\n// There is deliberately no admin rule here. The dashboard reads through the\n// Firebase Admin SDK, which bypasses these rules completely, so granting a\n// client-side read to some email address buys nothing and costs plenty: it\n// would mean anyone holding a token carrying that email claim could enumerate\n// every profile and every usage record. Admin access is a separate passphrase\n// (web/admin_auth.py) precisely so that no user account, however privileged,\n// is a way in.\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    // A profile belongs to exactly one uid and is reachable only by them.\n    match /users/{userId} {\n      allow read: if signedIn() && request.auth.uid == userId;\n\n      // The uid field must agree with both the document id and the caller, so\n      // a profile cannot be written that claims to belong to someone else.\n      // Sizes are capped because these fields are rendered back into the page.\n      allow create, update: if signedIn()\n        && request.auth.uid == userId\n        && request.resource.data.uid == userId\n        && request.resource.data.keys().hasOnly([\n          \"uid\", \"email\", \"anonymous\", \"first_name\", \"last_name\",\n          \"role\", \"purpose\", \"created_at\", \"last_seen_at\"\n        ])\n        && request.resource.data.first_name is string\n        && request.resource.data.first_name.size() <= 100\n        && request.resource.data.last_name is string\n        && request.resource.data.last_name.size() <= 100;\n\n      // Deletion belongs on the server, where related data can be cleaned up.\n      allow delete: if false;\n    }\n\n    // Append-only telemetry: a client may record an event about itself and may\n    // never read, edit or remove one. Usage history is not something one user\n    // should be able to enumerate, or another to rewrite.\n    match /usage_events/{eventId} {\n      allow read: if false;\n      allow update, delete: if false;\n      allow create: if signedIn()\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.keys().hasOnly([\n          \"uid\", \"feature\", \"method\", \"status\", \"duration_ms\", \"anonymous\", \"created_at\"\n        ])\n        && request.resource.data.feature is string\n        && request.resource.data.feature.size() <= 64;\n    }\n\n    // Anything not named above is closed. New collections opt in here rather\n    // than inherit access by accident.\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-29T20:27:04.605375Z","metadata":{"services":["cloud.firestore"]},"attachmentPoint":"firestore.googleapis.com/projects/625630291003/databases/default"}
