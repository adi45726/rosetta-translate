# Copy to .env and fill in. Everything here is optional: with no GROQ_API_KEY
# the app falls back to the keyless MyMemory provider and still works.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Any chat model on https://console.groq.com/docs/models.
# openai/gpt-oss-120b is the default: in side-by-side testing it was the only
# one of the three candidates that both produced correct CJK output and
# refused to obey instruction-shaped input instead of translating it.
GROQ_MODEL=openai/gpt-oss-120b
