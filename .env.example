# Copy to .env and fill in. Everything here is optional: with no GROQ_API_KEY
# the app falls back to the keyless MyMemory provider and still works.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Any chat model on https://console.groq.com/docs/models.
# openai/gpt-oss-120b is the default: in side-by-side testing it was the only
# one of the three candidates that both produced correct CJK output and
# refused to obey instruction-shaped input instead of translating it.
GROQ_MODEL=openai/gpt-oss-120b

# ─── Admin dashboard ────────────────────────────────────────────────────────
# The dashboard has its own credential, deliberately unrelated to user sign-in:
# no Google account, however privileged, opens it. Both of these must be set or
# the dashboard stays disabled (it fails closed, never open).
#
# Generate the hash — never store the passphrase itself:
#     python web/admin_auth.py "your long passphrase"
ADMIN_PASSWORD_HASH=
# Signs the admin session cookie. Any long random string; rotating it logs
# every admin session out immediately.
SECRET_KEY=

# ─── Stripe payments ────────────────────────────────────────────────────────
# Prefer a restricted key with write access to Checkout Sessions. A standard
# secret key also works as a fallback, but grants much broader access.
STRIPE_RESTRICTED_KEY=
# Copy the signing secret from the Stripe webhook endpoint configured for:
#   https://YOUR-DOMAIN/api/billing/webhook
# Subscribe that endpoint to `checkout.session.completed`.
STRIPE_WEBHOOK_SECRET=
# Canonical deployed origin used for Stripe return URLs (recommended).
# Example: https://rosetta.example.com
APP_BASE_URL=
